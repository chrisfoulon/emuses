# EMUSES Production Environment Configuration Template
# Copy this file to .env.production and fill in the actual values

# =============================================================================
# DEPLOYMENT CONFIGURATION
# =============================================================================

# Deployment mode - set to 'production' for production deployment
EMUSES_DEPLOYMENT_MODE=production

# Service configuration
EMUSES_SERVICE_HOST=0.0.0.0
EMUSES_SERVICE_PORT=8000
EMUSES_MAX_WORKERS=4

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL database connection
# Format: postgresql+asyncpg://username:password@host:port/database
DATABASE_URL=postgresql+asyncpg://emuses_user:CHANGE_THIS_PASSWORD@postgres:5432/emuses_db

# Database connection pool settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================

# JWT secret key - MUST be changed in production
# Generate with: openssl rand -hex 32
EMUSES_JWT_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING_IN_PRODUCTION

# JWT token expiration (in seconds)
JWT_ACCESS_TOKEN_EXPIRE_SECONDS=3600

# Password hashing settings
BCRYPT_ROUNDS=12

# =============================================================================
# STORAGE CONFIGURATION
# =============================================================================

# Root storage directory for user workspaces
EMUSES_STORAGE_ROOT=/app/storage

# Maximum storage per user (in GB)
DEFAULT_USER_STORAGE_QUOTA_GB=10

# Maximum compute hours per user per month
DEFAULT_USER_COMPUTE_QUOTA_HOURS=100

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log file location
LOG_FILE=/app/logs/emuses.log

# Log rotation settings
LOG_MAX_BYTES=10485760  # 10MB
LOG_BACKUP_COUNT=5

# =============================================================================
# CORS CONFIGURATION
# =============================================================================

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# =============================================================================
# EMAIL CONFIGURATION (Optional)
# =============================================================================

# SMTP settings for email notifications
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=noreply@yourdomain.com
SMTP_PASSWORD=CHANGE_THIS_EMAIL_PASSWORD
SMTP_TLS=true

# Email settings
FROM_EMAIL=noreply@yourdomain.com
FROM_NAME="EMUSES System"

# =============================================================================
# MONITORING & PERFORMANCE
# =============================================================================

# Enable performance monitoring
ENABLE_METRICS=true

# Metrics export endpoint
METRICS_PORT=9090

# Request timeout (in seconds)
REQUEST_TIMEOUT=300

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================

# Database backup settings
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30

# Storage backup settings
STORAGE_BACKUP_ENABLED=true
BACKUP_STORAGE_PATH=/app/backups

# =============================================================================
# ADMIN CONFIGURATION
# =============================================================================

# Default admin user (created on first startup)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=CHANGE_THIS_ADMIN_PASSWORD

# Admin token for CLI operations
ADMIN_TOKEN=CHANGE_THIS_TO_A_SECURE_ADMIN_TOKEN

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Enable user registration
ALLOW_USER_REGISTRATION=false

# Enable user workspace sharing
ENABLE_WORKSPACE_SHARING=false

# Enable real-time job status updates
ENABLE_REALTIME_UPDATES=true