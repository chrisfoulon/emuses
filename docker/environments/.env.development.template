# EMUSES Development Environment Configuration Template
# Copy this file to .env.development for local development
# These are safe defaults for development - no production secrets

# Database Configuration
POSTGRES_PASSWORD=dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=emuses_db_dev
POSTGRES_USER=emuses_user

# Redis Configuration
REDIS_PASSWORD=dev_redis_password
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=2

# JWT Security (Development only - not secure)
JWT_SECRET=development_jwt_secret_not_secure
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440  # 24 hours for dev

# SSL/TLS Configuration (Optional for dev)
SSL_CERT_PATH=/etc/nginx/ssl/dev.crt
SSL_KEY_PATH=/etc/nginx/ssl/dev.key
SSL_CA_CERT_PATH=/etc/nginx/ssl/dev-ca.pem

# Backup and Encryption (Not needed for dev)
BACKUP_ENCRYPTION_KEY=dev_backup_key_not_secure
BACKUP_RETENTION_DAYS=1
BACKUP_SCHEDULE=0 0 * * 0

# Application Configuration
EMUSES_DEPLOYMENT_MODE=development
EMUSES_SERVICE_HOST=0.0.0.0
EMUSES_SERVICE_PORT=8000
EMUSES_MAX_WORKERS=2
EMUSES_STORAGE_ROOT=/tmp/emuses/storage

# Logging Configuration (Verbose for debugging)
LOG_LEVEL=DEBUG
LOG_FORMAT=console
SYSLOG_HOST=localhost
SYSLOG_PORT=514

# Monitoring and Observability
PROMETHEUS_ENABLED=false
GRAFANA_ADMIN_PASSWORD=admin
METRICS_ENDPOINT_ENABLED=true

# Email Configuration (Mock/disabled)
SMTP_HOST=localhost
SMTP_PORT=1025  # MailHog or similar
SMTP_USERNAME=dev@localhost
SMTP_PASSWORD=dev_password
SMTP_TLS=false

# Security Headers (Relaxed for development)
SECURITY_CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000
SECURITY_CSRF_SECRET=dev_csrf_secret
SECURITY_RATE_LIMIT_PER_MINUTE=1000

# External Integrations (Mock/disabled)
CLOUD_STORAGE_PROVIDER=local
AWS_ACCESS_KEY_ID=dev_key
AWS_SECRET_ACCESS_KEY=dev_secret
AWS_S3_BUCKET=emuses-dev-models
AWS_REGION=us-east-1

# Resource Limits (Very permissive for dev)
MAX_MODEL_SIZE_MB=100
MAX_CONCURRENT_JOBS=2
MAX_STORAGE_PER_USER_GB=1

# Network Configuration
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
TRUSTED_PROXY_IPS=127.0.0.1,::1

# Maintenance Mode
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE="Development environment"

# Feature Flags (All enabled for testing)
FEATURE_MODEL_SHARING=true
FEATURE_ANALYTICS=true
FEATURE_CLOUD_SYNC=false  # Disabled in dev
FEATURE_ADVANCED_SEARCH=true

# Development-specific settings
DEV_RELOAD=true
DEV_DEBUG_MODE=true
DEV_MOCK_EXTERNAL_APIS=true
DEV_SKIP_MIGRATIONS=false