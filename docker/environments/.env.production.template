# EMUSES Production Environment Configuration Template
# Copy this file to .env.production and fill in the actual values
# DO NOT commit .env.production with real secrets to version control

# Database Configuration
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=emuses_db
POSTGRES_USER=emuses_user

# Redis Configuration
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD_HERE
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# JWT Security
JWT_SECRET=CHANGE_ME_LONG_RANDOM_JWT_SECRET_KEY_HERE
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# SSL/TLS Configuration
SSL_CERT_PATH=/etc/nginx/ssl/emuses.crt
SSL_KEY_PATH=/etc/nginx/ssl/emuses.key
SSL_CA_CERT_PATH=/etc/nginx/ssl/ca-cert.pem

# Backup and Encryption
BACKUP_ENCRYPTION_KEY=CHANGE_ME_BACKUP_ENCRYPTION_KEY_HERE
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE=0 2 * * *

# Application Configuration
EMUSES_DEPLOYMENT_MODE=production
EMUSES_SERVICE_HOST=0.0.0.0
EMUSES_SERVICE_PORT=8000
EMUSES_MAX_WORKERS=8
EMUSES_STORAGE_ROOT=/app/storage

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
SYSLOG_HOST=localhost
SYSLOG_PORT=514

# Monitoring and Observability
PROMETHEUS_ENABLED=true
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_ADMIN_PASSWORD
METRICS_ENDPOINT_ENABLED=true

# Email Configuration (for alerts)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=alerts@example.com
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
SMTP_TLS=true

# Security Headers
SECURITY_CORS_ORIGINS=https://your-domain.com
SECURITY_CSRF_SECRET=CHANGE_ME_CSRF_SECRET_HERE
SECURITY_RATE_LIMIT_PER_MINUTE=100

# External Integrations
CLOUD_STORAGE_PROVIDER=aws  # aws, azure, gcp
AWS_ACCESS_KEY_ID=CHANGE_ME_AWS_KEY
AWS_SECRET_ACCESS_KEY=CHANGE_ME_AWS_SECRET
AWS_S3_BUCKET=emuses-production-models
AWS_REGION=us-east-1

# Resource Limits
MAX_MODEL_SIZE_MB=1000
MAX_CONCURRENT_JOBS=10
MAX_STORAGE_PER_USER_GB=10

# Network Configuration
ALLOWED_HOSTS=your-domain.com,localhost,127.0.0.1
TRUSTED_PROXY_IPS=192.168.0.0/16,10.0.0.0/8

# Maintenance Mode
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE="System maintenance in progress"

# Feature Flags
FEATURE_MODEL_SHARING=true
FEATURE_ANALYTICS=true
FEATURE_CLOUD_SYNC=true
FEATURE_ADVANCED_SEARCH=true