# EMUSES Secrets Template
# Copy this file to 'secrets.env' and fill in actual secret values
# This file contains sensitive information - never commit to version control

# =============================================================================
# CRITICAL SECURITY SECRETS
# =============================================================================

# JWT signing secret - generate with: openssl rand -hex 32
JWT_SECRET=

# Database password for application user
POSTGRES_PASSWORD=

# Admin user password for initial setup
ADMIN_PASSWORD=

# Admin API token for CLI administration
ADMIN_TOKEN=

# =============================================================================
# EMAIL SECRETS
# =============================================================================

# SMTP password for email notifications
SMTP_PASSWORD=

# =============================================================================
# EXTERNAL SERVICE SECRETS
# =============================================================================

# API keys for external services (if used)
EXTERNAL_API_KEY=

# OAuth secrets (if implementing OAuth authentication)
OAUTH_CLIENT_SECRET=

# =============================================================================
# ENCRYPTION KEYS
# =============================================================================

# Additional encryption key for sensitive data
DATA_ENCRYPTION_KEY=

# Session encryption key
SESSION_SECRET_KEY=

# =============================================================================
# BACKUP ENCRYPTION
# =============================================================================

# Encryption key for backup files
BACKUP_ENCRYPTION_KEY=

# =============================================================================
# MONITORING SECRETS
# =============================================================================

# Secrets for monitoring services
MONITORING_API_KEY=